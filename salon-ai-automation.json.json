              "type": "string",
              "value": "={{ ($json.output?.reply || 'Thanks for your message! Our team will get back to you shortly.').toString().slice(0, 1500) }}"
            },
            {
              "id": "p2",
              "name": "intent",
              "type": "string",
              "value": "={{ $json.output?.intent || 'error' }}"
            },
            {
              "id": "p3",
              "name": "handoff",
              "type": "boolean",
              "value": "={{ !$json.output || !!$json.output.escalate || ['complaint', 'human_request', 'reschedule', 'cancel'].includes($json.output.intent) }}"
            },
            {
              "id": "p4",
              "name": "reason",
              "type": "string",
              "value": "={{ $json.output ? ($json.output.escalation_reason || '') : 'AI processing error - fallback reply sent' }}"
            },
            {
              "id": "p5",
              "name": "detected_name",
              "type": "string",
              "value": "={{ $json.output?.customer_name || '' }}"
            }
          ]
